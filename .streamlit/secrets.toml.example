# Copy to .streamlit/secrets.toml and fill real values.
# Swap to SSO later: add SSO_CLIENT_ID here.
SNOWFLAKE_ACCOUNT = "your-account"
SNOWFLAKE_USER = "your-user"
# Password login is local dev only. Prod uses key-pair below.
SNOWFLAKE_PASSWORD = "your-password"
# Key-pair JWT auth. Preferred for prod.
# Docs: https://docs.snowflake.com/en/user-guide/key-pair-auth
# Set path to PEM private key file. Ask admin for key. Add public key via ALTER USER.
SNOWFLAKE_PRIVATE_KEY_PATH = ""
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE = ""
SNOWFLAKE_WAREHOUSE = "COMPUTE_WH"
SNOWFLAKE_DATABASE = "RISK_INTELLIGENCE_DB"
SNOWFLAKE_SCHEMA = "COMPLIANCE"
SNOWFLAKE_ROLE = "ANALYST"
# Must be min 12 chars. Never keep CHANGE_ME. Local only, SiS uses st.user login.
APP_PASSWORD = "CHANGE_ME___SET_ME"
# LLM models. Primary mistral-large3 (256K), cheap draft llama3.1-8b.
# Docs: https://docs.snowflake.com/en/user-guide/snowflake-cortex/aisql-regional-availability
